{
  "manifest_version": 3,
  "name": "Memory Nap Tabs — умный менеджер памяти",
  "short_name": "Memory Nap",
  "description": "Усыпляет неактивные вкладки, защищает формы и плееры, показывает реальную экономию оперативной памяти.",
  "version": "3.0.0",
  "minimum_chrome_version": "121",
  "permissions": ["tabs", "storage", "alarms", "contextMenus", "scripting", "system.memory"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "optional_host_permissions": ["file:///*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Memory Nap Tabs",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "discard-current-tab": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Усыпить текущую вкладку"
    },
    "discard-inactive-tabs": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Усыпить все неактивные вкладки"
    },
    "wake-all-tabs": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "Разбудить все вкладки"
    }
  }
}